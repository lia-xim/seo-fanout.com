  {"@type":"HowToStep",name:"Separate branches from demand",text:"Treat branches as planning hypotheses until search, customer, or site evidence supports them."},
  {"@type":"HowToStep",name:"Audit page ownership",text:"Compare indexability, promise, evidence, coverage, journey, and maintenance owner."},
