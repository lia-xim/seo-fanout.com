import BaseLayout from "../../layouts/BaseLayout.astro";
const structuredData={"@context":"https://schema.org","@type":"HowTo",name:"AI Fanout to SEO research workflow",description:"Reuse one visible AI query fanout result for a browser-local SEO research plan without a second provider request.",step:[{"@type":"HowToStep",name:"Run AI Fanout once",text:"Ask one short question and review the provider-exposed queries and sources."},{"@type":"HowToStep",name:"Open the SEO research view",text:"Transfer selected visible result fields through a browser fragment."},{"@type":"HowToStep",name:"Review work packages",text:"Inspect the deterministic query groups, deliverables, proof requirements and visible source scope."},{"@type":"HowToStep",name:"Verify separately",text:"Use demand and site evidence before making an SEO publication decision."}]};
---
<BaseLayout title="AI query fanout to SEO research" description="One provider request becomes a raw AI Fanout view and a deeper browser-local SEO research view without another AI call." canonicalPath="/seo-query-fanout-workflow/" pageClass="reference-page" structuredData={structuredData}>
  <header class="reference-hero"><p class="mono-label">Workflow · one run, two views</p><h1>Reuse the fanout. Do not run it twice.</h1><p>AI Fanout owns the provider request. SEO Fanout receives a bounded copy of the result already visible to the visitor and performs only deterministic browser-side analysis.</p></header>
  <section class="reference-section split-section"><div><p class="mono-label">AI Fanout</p><h2>Observe the search actions.</h2><p>The upstream tool records the short input, provider, locale, exposed query strings and sources at the scope returned by the API. It does not claim consumer-interface internals.</p></div><div><p class="mono-label">SEO Fanout</p><h2>Inspect the research shape.</h2><p>The downstream view groups query wording, counts recurring terms, preserves source scope and identifies checks still required before treating the run as SEO evidence.</p></div></section>
  <section class="reference-section"><div class="section-heading"><p class="mono-label">Data flow</p><h2>The handoff remains in the browser.</h2></div><ol class="method-list"><li><span>01</span><div><h3>Select the useful visible queries</h3><p>AI Fanout starts with all exposed queries selected. The visitor may narrow the set before continuing.</p></div></li><li><span>02</span><div><h3>Create a versioned fragment</h3><p>The browser creates <code>ai-fanout.seo-research-handoff/1.0</code>. Raw provider responses, secrets and local history are excluded.</p></div></li><li><span>03</span><div><h3>Validate and clear the fragment</h3><p>SEO Fanout validates size, schema, producer, URLs and field limits, then removes the fragment from the address bar.</p></div></li><li><span>04</span><div><h3>Build the local plan</h3><p>No API call occurs. The user may copy or download the resulting research plan.</p></div></li></ol></section>
  <section class="reference-section"><div class="section-heading"><p class="mono-label">Evidence boundary</p><h2>Observed query strings are still only one bounded run.</h2></div><p>They do not establish demand, ranking factors, permanent provider behaviour or a requirement to create content. Source relationships remain exactly as coarse as the provider exposed them.</p><a class="button-link" href="https://ai-fanout.com/#tool">Start one AI Fanout run</a></section>
</BaseLayout>
