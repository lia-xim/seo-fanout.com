---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fieldNotes } from "../../data/content";
---

<BaseLayout title="Field notes" description="Editorial notes on page decisions, evidence readiness, inventory ownership, and the work that should not become another URL." canonicalPath="/blog/" pageClass="reference-page">
  <header class="reference-hero editorial-hero">
    <h1>Field notes from the decision layer.</h1>
    <p>Short, accountable arguments about what to publish, what to measure, and what to leave alone. No trend summaries for their own sake.</p>
  </header>
  <section class="note-archive" aria-label="Published field notes">
    {fieldNotes.map((note, index) => (
      <article>
        <span class="row-index">0{index + 1}</span>
        <div><time datetime={note.published}>{note.published}</time><h2><a href={`/blog/${note.slug}/`}>{note.title}</a></h2><p>{note.description}</p></div>
        <a class="note-arrow" href={`/blog/${note.slug}/`} aria-label={`Read ${note.title}`}>→</a>
      </article>
    ))}
  </section>
</BaseLayout>