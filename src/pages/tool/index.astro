---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoResearchTool from "../../components/SeoResearchTool.astro";
import { site } from "../../data/site";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "SEO Query Fanout Research",
  url: `${site.origin}/tool/`,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any",
  browserRequirements: "JavaScript enabled",
  isAccessibleForFree: true,
  softwareVersion: "1.2.0",
  inLanguage: "en",
  featureList: [
    "Browser-local AI Fanout result handoff",
    "Deterministic SEO work-package and source-scope analysis",
    "Documented owner-run OpenAI example with published provenance",
    "Local SEO research-plan export",
  ],
  description: site.description,
  creator: {
    "@type": "Person",
    name: site.operator.name,
  },
};
---

<BaseLayout canonicalPath="/tool/" structuredData={structuredData} pageClass="tool-page">
  <SeoResearchTool />
</BaseLayout>
