---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DecisionLab from "../../components/DecisionLab.astro";
import { site } from "../../data/site";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "SEO Page Decision Stress Test",
  url: `${site.origin}/lab/`,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any",
  browserRequirements: "JavaScript enabled",
  isAccessibleForFree: true,
  description: "A browser-local sensitivity test for SEO page decisions.",
  creator: { "@type": "Person", name: site.operator.name },
};
---

<BaseLayout
  title="SEO Page Decision Stress Test"
  description="Stress-test how existing page coverage and evidence readiness change a deterministic SEO page decision."
  canonicalPath="/lab/"
  pageClass="lab-page"
  structuredData={structuredData}><DecisionLab /></BaseLayout
>
