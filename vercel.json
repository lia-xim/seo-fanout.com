{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/tool/",
      "permanent": true
    }
  ]
}
